# default
[core]
    remote = read-testdata
# read-only, public access used in CI
['remote "read-testdata"']
    url = s3://wflow/testdata
    endpointurl = https://s3.deltares.nl/
    allow_anonymous_login = true
    region = eu-west-1
# read-write, for maintainers uploading new data
['remote "write-testdata"']
    url = s3://wflow/testdata
    endpointurl = https://s3.deltares.nl/
    region = eu-west-1
